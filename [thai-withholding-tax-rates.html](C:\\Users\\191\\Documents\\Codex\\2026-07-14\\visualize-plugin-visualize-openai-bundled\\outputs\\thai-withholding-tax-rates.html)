<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ภาษีเงินได้หัก ณ ที่จ่าย</title>
  <style>
    :root { --ink:#172033; --muted:#5b6577; --line:#dbe2ea; --paper:#fff; --wash:#f5f7fb; --brand:#075985; --accent:#e0f2fe; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:var(--wash); font-family:system-ui,-apple-system,"Noto Sans Thai",sans-serif; line-height:1.55; }
    .wrap { max-width:1240px; margin:auto; padding:28px 20px 48px; }
    header { border-left:6px solid var(--brand); padding:4px 0 4px 18px; margin-bottom:24px; }
    h1 { font-size:clamp(1.55rem,3vw,2.25rem); line-height:1.2; margin:0 0 8px; }
    h2 { font-size:1.2rem; margin:0; }
    .subtitle,.fine { color:var(--muted); margin:0; }
    .toolbar { display:flex; gap:12px; align-items:end; flex-wrap:wrap; background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:14px; margin-bottom:16px; }
    .field { display:grid; gap:4px; min-width:220px; flex:1; }
    label { font-size:.9rem; font-weight:650; }
    input,select { width:100%; padding:9px 10px; border:1px solid #aeb9c8; border-radius:7px; color:var(--ink); background:#fff; font:inherit; }
    .count { margin-left:auto; color:var(--muted); font-size:.9rem; white-space:nowrap; }
    .table-shell { background:var(--paper); border:1px solid var(--line); border-radius:12px; overflow:auto; }
    table { width:100%; border-collapse:collapse; min-width:980px; }
    th,td { padding:14px; vertical-align:top; text-align:left; border-bottom:1px solid var(--line); }
    th { background:#f8fafc; color:#344155; font-size:.9rem; position:sticky; top:0; }
    tr:last-child td { border-bottom:0; }
    tr:hover td { background:#fbfdff; }
    .rate { display:inline-block; min-width:54px; padding:3px 8px; border-radius:999px; background:var(--accent); color:#075985; font-weight:750; text-align:center; }
    .law { color:#42526a; font-size:.92rem; }
    .notes { margin-top:22px; background:#fff; border:1px solid var(--line); border-radius:12px; padding:20px; }
    .notes ul { margin:10px 0 0; padding-left:1.3rem; }
    a { color:#0369a1; }
    @media (max-width:700px) { .wrap { padding:20px 13px 36px; } .toolbar { align-items:stretch; } .field { min-width:100%; } .count { margin-left:0; } .table-shell { border:0; background:transparent; overflow:visible; } table,tbody,tr,td { display:block; min-width:0; width:100%; } thead { display:none; } tr { background:#fff; border:1px solid var(--line); border-radius:10px; padding:12px; margin:12px 0; } td { padding:5px 0; border:0; } td::before { content:attr(data-label); display:block; color:var(--muted); font-size:.82rem; font-weight:650; margin-bottom:2px; } td:first-child::before { display:none; } }
  </style>
</head>
<body>
  <main class="wrap">
    <header>
      <h1>ภาษีเงินได้หัก ณ ที่จ่าย</h1>
      <p class="subtitle">อัตราปกติ ณ 14 กรกฎาคม 2569 · เรียงจากต่ำไปสูง</p>
      <p class="fine">ครอบคลุมกรณีผู้รับในประเทศไทยหรือมีสถานประกอบการถาวรในประเทศไทย เว้นแต่ระบุเป็นกรณีต่างประเทศ</p>
    </header>
    <section class="toolbar" aria-label="ค้นหาตาราง">
      <div class="field"><label for="search">ค้นหารายการ</label><input id="search" type="search" placeholder="เช่น ค่าเช่า, ดอกเบี้ย, ภ.ง.ด.53"></div>
      <div class="field"><label for="rate-filter">อัตราภาษี</label><select id="rate-filter"><option value="">ทุกอัตรา</option></select></div>
      <output id="count" class="count" aria-live="polite"></output>
    </section>
    <section class="table-shell" aria-label="ตารางอัตราภาษีเงินได้หัก ณ ที่จ่าย">
      <table>
        <thead><tr><th>อัตรา</th><th>ประเภทเงินได้ / เงื่อนไข</th><th>ผู้มีหน้าที่หัก (ผู้จ่าย)</th><th>ผู้ถูกหัก (ผู้รับ)</th><th>กฎหมาย / แบบ</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </section>
    <section class="notes">
      <h2>หมายเหตุสำคัญ</h2>
      <ul>
        <li>อัตรา e-Withholding Tax 1% เป็นมาตรการชั่วคราวที่สิ้นสุด 31 ธันวาคม 2568 จึงไม่รวมเป็นอัตราปัจจุบัน</li>
        <li>อนุสัญญาภาษีซ้อนอาจลดอัตราตามมาตรา 70 ได้ เมื่อเข้าเงื่อนไขและมีเอกสารครบถ้วน</li>
        <li>การยกเว้น/ข้อยกเว้นเฉพาะกิจการและฐานภาษี (โดยทั่วไปก่อน VAT) ต้องตรวจข้อเท็จจริงก่อนใช้</li>
      </ul>
      <p class="fine">อ้างอิง: <a href="https://www.rd.go.th/3479.html">คำสั่งกรมสรรพากร ท.ป.4/2528</a> · <a href="https://www.rd.go.th/fileadmin/download/insight_pasi/wht_3_53_030260.pdf">คู่มือ ภ.ง.ด.3 และ ภ.ง.ด.53</a> · <a href="https://www.rd.go.th/fileadmin/user_upload/kormor/newlaw/tp354A.pdf">ท.ป.354/2566</a></p>
    </section>
  </main>
